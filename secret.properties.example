# Copy to secret.properties (gitignored) for builds that talk to the YMusic config service:
# device-link (QR) sign-in, remote config and bundle updates, SponsorBlock, crash reports.
# Values come from YMusicV4's secrets.properties / local.properties. Env vars of the same purpose
# (YMUSIC_REMOTE_CONFIG_URL, YMUSIC_BUNDLE_PUBLIC_KEY, YMUSIC_API_KEY, YMUSIC_SENTRY_DSN) win.
remote.config.url=
bundle.signing.public.key=
api.key=
sentry.dsn=
